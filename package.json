{
  "name": "officina",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test packages/core packages/github packages/runner apps/api",
    "test:db": "bun packages/db/test/with-postgres.ts",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "dev": "bun apps/api/src/dev.ts",
    "dev:board": "cd apps/board && bun run dev",
    "check:board": "cd apps/board && bun run check",
    "build:board": "cd apps/board && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "prettier": "^3.9.7",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^7.0.2"
  }
}
