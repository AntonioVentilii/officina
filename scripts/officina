#!/usr/bin/env bash
# Runs an Officina CLI command on the deployed server, e.g.
#   scripts/officina task list
#   scripts/officina task create --title "Fix the settings title" --request "Call it Preferences"
# Arguments are sent base64-encoded, so text with spaces and quotes arrives exactly as typed.
set -euo pipefail
APP="${OFFICINA_APP:-vici-officina}"
if [ "$#" -eq 0 ]; then set -- --help; fi
ARGS=$(python3 -c 'import base64, json, sys; print(base64.b64encode(json.dumps(sys.argv[1:]).encode()).decode())' "$@")
fly ssh console --app "$APP" -C "bun apps/api/src/cli.ts --b64 $ARGS" 2>&1 | grep -v '^Connecting to '
